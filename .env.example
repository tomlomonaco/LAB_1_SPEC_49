# Copy to .env and fill in. Placeholders only; never commit real values.
# "root" = scheme + host only (no path, query, or trailing slash); code appends documented paths.
# "endpoint" = complete URL used verbatim; code never appends to it.

# --- Bridge (hook-to-socket) ---
# root
BRIDGE_WS_BASE_URL=wss://bridge.example.com
PAIR_ID=your_pair_id
RECONNECT_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000

# --- Webex Messaging (bot) ---
# root
WEBEX_API_ROOT_URL=https://webexapis.com
WEBEX_BOT_TOKEN=<bot-token>
WEBEX_BOT_EMAIL=bot@webex.bot

# --- Webex Contact Center ---
# root
WXCC_API_ROOT_URL=https://api.wxcc-us1.cisco.com
# endpoint
WXCC_TOKEN_URL=https://webexapis.com/v1/access_token
WXCC_CLIENT_ID=<client-id>
WXCC_CLIENT_SECRET=<client-secret>
WXCC_REFRESH_TOKEN=<refresh-token>
WXCC_BUSINESS_ADDRESS=support@channel.example
WXCC_CHANNEL_NAME=my-custom-channel

# --- Service ---
PENDING_TASK_TIMEOUT_MS=30000
READINESS_PORT=3000
